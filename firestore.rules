rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /phoneIndex/{phoneId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(conversationId);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isParticipant(conversationId)
        && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(conversationId);
        allow create: if isParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && (
            (request.resource.data.kind == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 10000)
            ||
            (request.resource.data.kind == 'voice'
              && request.resource.data.text == ''
              && request.resource.data.audioUrl is string
              && request.resource.data.storagePath is string
              && request.resource.data.durationMs is int
              && request.resource.data.durationMs > 0
              && request.resource.data.durationMs <= 300000
              && request.resource.data.mimeType is string
              && request.resource.data.mimeType.matches('audio/.*'))
          );
        allow update, delete: if isParticipant(conversationId) && resource.data.senderId == request.auth.uid;

        match /receipts/{uid} {
          allow read: if isParticipant(conversationId);
          allow create, update: if isParticipant(conversationId) && uid == request.auth.uid;
          allow delete: if false;
        }
      }

      match /typing/{uid} {
        allow read: if isParticipant(conversationId);
        allow create, update: if isParticipant(conversationId) && uid == request.auth.uid;
        allow delete: if isParticipant(conversationId) && uid == request.auth.uid;
      }
    }
  }
}
